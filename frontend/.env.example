# Copy to .env.local for local development (never commit .env.local):
#   cp frontend/.env.example frontend/.env.local
# Backend runs on 127.0.0.1:8001 locally (port 8000 belongs to Sherlock).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
# Clerk publishable key. Blank keeps the local username/password flow active.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

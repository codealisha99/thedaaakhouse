# ---- App ----
APP_NAME=thedaaakhouse
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call the API (browser CORS).
# Must include every port you serve the frontend from.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Auth (HS256 JWT, PBKDF2 passwords — stdlib, no extra deps).
# Development may use the built-in default. PRODUCTION MUST set a long
# random secret, otherwise the backend refuses to start.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_MIN=10080

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
DATABASE_URL=postgresql+psycopg2://thedaaakhouse:thedaaakhouse@localhost:5432/thedaaakhouse

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# ---- LLM provider: "ollama" | "openai_compatible" ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible (used when LLM_PROVIDER=openai_compatible)
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# ---- Embeddings: "local" (stub) — plug real provider later ----
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384

# ---- Storage ----
DATA_DIR=./data
MAX_UPLOAD_MB=10

# ---- Postgres (docker-compose) ----
POSTGRES_USER=thedaaakhouse
POSTGRES_PASSWORD=thedaaakhouse
POSTGRES_DB=thedaaakhouse
POSTGRES_PORT=5432

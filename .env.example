# ---- App ----
APP_NAME=thedaaakhouse
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call the API (browser CORS).
# Must include every port you serve the frontend from.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100

# Auth (HS256 JWT, PBKDF2 passwords — stdlib, no extra deps).
# Development may use the built-in default. PRODUCTION MUST set a long
# random secret, otherwise the backend refuses to start.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_MIN=10080

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
DATABASE_URL=postgresql+psycopg2://thedaaakhouse:thedaaakhouse@localhost:5432/thedaaakhouse

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# ---- LLM provider: "ollama" | "openai_compatible" | "grok" ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible (used when LLM_PROVIDER=openai_compatible)
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Grok (xAI) boundary — DISABLED placeholder. Core features never route here.
# To enable later: LLM_PROVIDER=grok, GROK_ENABLED=true, GROK_API_KEY set.
GROK_ENABLED=false
GROK_BASE_URL=https://api.x.ai/v1
GROK_API_KEY=
GROK_MODEL=grok-3

# ---- Embeddings: "local" (stub) — plug real provider later ----
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384

# ---- Storage ----
DATA_DIR=./data
MAX_UPLOAD_MB=10

# ---- Postgres (docker-compose) ----
POSTGRES_USER=thedaaakhouse
POSTGRES_PASSWORD=thedaaakhouse
POSTGRES_DB=thedaaakhouse
POSTGRES_PORT=5432

# ---- Durable tasks (step 02) ----
# Redis is the optional delivery bus; task state is always in the database.
# Leave REDIS_URL empty to run without Redis (the poll-mode DB worker is enough).
REDIS_URL=
REDIS_QUEUE_NAME=tasks
WF_MAX_ATTEMPTS=5
WF_RETRY_BASE_S=1.0
WF_RETRY_JITTER=0.25
WF_LEASE_SECONDS=300
WF_DISPATCHER_INTERVAL_S=1.0
WF_POLL_INTERVAL_S=1.0
WF_SHUTDOWN_GRACE_S=30

# ---- Safe fetcher (step 01) ----
# One centralized fetcher for every user-supplied URL (job import, company
# research, future discovery/contacts). HTTP(S) only, private/reserved/loopback
# targets blocked, redirects re-validated, response bodies size-capped.
FETCH_TIMEOUT_S=20.0
FETCH_MAX_BYTES=1000000
FETCH_MAX_REDIRECTS=5
# Public web ports only. Add 8443 etc. only if you really need them.
FETCH_ALLOWED_PORTS=80,443
FETCH_USER_AGENT=thedaaakhouse/0.3 (+safe-fetch)

# Startup-search provider for opportunity discovery ("none" = user-supplied URLs only).
# Custom adapters register in backend/app/opportunities/providers.py.
STARTUP_SEARCH_PROVIDER=none
